# Copy this file to .env and fill values locally.
# Never commit real API keys.

# 네이버 API HUB. 키(Application)마다 일 25,000회 한도라 여러 개를 번호순으로 쓴다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CLIENT_ID_2=
NAVER_CLIENT_SECRET_2=

KAKAO_REST_API_KEY=
KAKAO_REST_API_KEY_2=

# 원본 데이터 루트 절대경로 (00_raw/ 상위 디렉터리). 이 값 자체는 비밀이 아니지만
# 로컬 환경마다 경로가 다르므로 .env로 관리한다.
PROJECT_DATA_ROOT=
