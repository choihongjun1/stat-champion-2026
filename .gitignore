# Secrets
.env
.env.*
!.env.example
*.key

# Data (repo 루트의 원본 데이터만 — src/data/ 등 소스 패키지는 제외)
/data/*
!/data/manual/
*.csv
*.xlsx
*.xls
*.parquet
*.zip

# ER 검증용 수작업 판정/고정 표본(CSV)은 실제 점포 정보가 있어 공개 저장소에 두지 않는다(로컬 전용).
# 안내 README만 추적하고, CSV는 위 *.csv 규칙으로 무시된다.
!/data/manual/
# 예외: 지원사업 원천(공개 공고 정보, 점포 식별정보 없음). src/serving/policy_apply.py가
# 이 두 파일의 sha256을 고정하므로 원본 바이트 그대로 둔다(DATA_CATALOG §7).
!/data/policies/
!/data/policies/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Model artifacts
*.pkl
*.joblib
*.bin

# Outputs
outputs/*
!outputs/.gitkeep

# W2-5 serving canonical DB (real store results must never be committed)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
